# ============================================================
# WhatsApp Business Cloud API (Meta)
# ============================================================
# Token de acesso (System User token de longa duração é o recomendado
# para produção; um token temporário de app expira em pouco tempo).
WHATSAPP_TOKEN=

# ID do número de telefone do WhatsApp Business (não é o número em si,
# é o Phone Number ID exibido no Meta Business Manager / App Dashboard).
WHATSAPP_PHONE_NUMBER_ID=

# ID da WhatsApp Business Account (WABA). Não é usado para enviar
# mensagens, mas fica documentado aqui para referência/gestão de templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Versão da Graph API usada nas chamadas.
WHATSAPP_API_VERSION=v20.0

# Nome exato do template aprovado no Meta Business Manager.
# Veja no README como criar o template "cobranca_pendente" com as
# variáveis {{1}}=nome, {{2}}=valor, {{3}}=vencimento.
WHATSAPP_TEMPLATE_NAME=cobranca_pendente

# Idioma configurado no template (o código do idioma deve ser IDÊNTICO
# ao cadastrado no Meta Business Manager, ex: pt_BR).
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Intervalo (em ms) entre cada envio, para não estourar o rate limit da API.
WHATSAPP_SEND_DELAY_MS=1200

# Tentativas de retry em caso de falha transitória (5xx, timeout, 429).
WHATSAPP_MAX_RETRIES=3

# Delay base (ms) do backoff exponencial entre retries (2s, 4s, 8s, ...).
WHATSAPP_RETRY_BASE_DELAY_MS=2000

# ============================================================
# Google Sheets API (Service Account)
# ============================================================
# ID da planilha (está na URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Intervalo de células a ler, incluindo a linha de cabeçalho.
# Ordem das colunas esperada: nome | telefone | valor devido | data de vencimento | status
GOOGLE_SHEETS_RANGE=Página1!A:E

# E-mail da Service Account (formato: nome@projeto.iam.gserviceaccount.com).
# Compartilhe a planilha com este e-mail (permissão de Leitor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Chave privada da Service Account, exatamente como está no JSON baixado
# do Google Cloud (campo "private_key"), com as quebras de linha como \n.
# Exemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ============================================================
# Agendamento (node-cron)
# ============================================================
# Expressão cron padrão: todo dia às 9h.
CRON_SCHEDULE="0 9 * * *"

# Timezone usado tanto pelo cron quanto para calcular "vencido até hoje".
CRON_TIMEZONE=America/Sao_Paulo

# ============================================================
# Regras de negócio
# ============================================================
# DDI usado para normalizar telefones que não vierem com código do país.
DEFAULT_COUNTRY_CODE=55

# ============================================================
# Logs
# ============================================================
LOG_LEVEL=info

# ============================================================
# Painel web (gestão de devedores)
# ============================================================
PANEL_PORT=3000

# Usuário e senha exigidos (HTTP Basic Auth) para acessar o painel.
# Obrigatório, principalmente se for publicar o painel na internet.
PANEL_USERNAME=
PANEL_PASSWORD=
